<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the Thortspace engine targets net8.0-windows (build with any newer SDK; RollForward
         lets the exe run on newer runtimes). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThortspaceKnowledgeNetwork</RootNamespace>
    <AssemblyName>ThortspaceKnowledgeNetwork</AssemblyName>
    <RollForward>Major</RollForward>
    <!-- The engine references WinForms types on some (non-headless) paths; keep the desktop framework
         available so a stray load can never fail at runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Thortspace headless SDK: the engine DLL + its dependency closure, as a normal NuGet package.
         Restored from the feed in ../nuget.config (local until the package is published publicly). -->
    <!-- Group categories (SetGroupCategory) need a package built from an engine that HAS them, so this
         pin must not go below 1.6.900. Highest published when this was written: 1.6.727. -->
    <PackageReference Include="Thortspace.Headless" Version="1.6.900" />
  </ItemGroup>

</Project>




